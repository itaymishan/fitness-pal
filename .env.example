# Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, never expose to the client.
# Only needed for local scripts/admin tasks; the app itself does not use it.
SUPABASE_SERVICE_ROLE_KEY=
